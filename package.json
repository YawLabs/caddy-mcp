{
  "name": "@yawlabs/caddy-mcp",
  "version": "2.1.0",
  "mcpName": "io.github.YawLabs/caddy-mcp",
  "description": "MCP server for managing Caddy web servers via the admin API",
  "license": "MIT",
  "author": "Yaw Labs <contact@yaw.sh> (https://yaw.sh)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "caddy-mcp": "bin/caddy-mcp.mjs"
  },
  "files": [
    "bin/caddy-mcp.mjs",
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:tsc": "tsc --noEmit",
    "test:ci": "npm run build && npm test",
    "prepublishOnly": "npm run build",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "hono": "^4.12.21",
    "@hono/node-server": "^1.19.13",
    "postcss": "^8.5.10",
    "ip-address": "^10.1.1",
    "fast-uri": "^3.1.2",
    "qs": "^6.15.2",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.11",
    "@types/node": "^26.0.0",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "caddy",
    "reverse-proxy",
    "web-server",
    "mcp-server",
    "devtools",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YawLabs/caddy-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/YawLabs/caddy-mcp/issues"
  },
  "homepage": "https://github.com/YawLabs/caddy-mcp"
}
